{
  "name": "die-schachmaschine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node --env-file-if-exists=.env server.mjs",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.mjs",
    "test:server": "node tests/server-check.mjs",
    "test:journey": "node tests/journey-browser.mjs",
    "multiplayer:dev": "wrangler dev --ip 127.0.0.1 --port 8788",
    "multiplayer:deploy": "wrangler deploy",
    "test:multiplayer:api": "node tests/multiplayer-api.mjs",
    "test:multiplayer:browser": "node tests/multiplayer-browser.mjs",
    "build:play": "node scripts/build-play.mjs",
    "test:play": "node tests/play-browser.mjs",
    "test:play:multiplayer": "node tests/play-multiplayer-browser.mjs",
    "test:perspectives": "node tests/perspective-browser.mjs",
    "test:perspectives:multiplayer": "node tests/perspective-multiplayer-browser.mjs",
    "test:reading-stage": "node tests/reading-stage-browser.mjs",
    "build:edition": "python3 scripts/build-edition.py",
    "test:edition": "node tests/edition-browser.mjs"
  },
  "dependencies": {
    "chess.js": "1.4.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "vite": "7.3.6",
    "wrangler": "^4.143.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
